APP_NAME="P90 Admin"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
APP_KEY=
APP_INSTALLED=false

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=p90
DB_USERNAME=p90
DB_PASSWORD=p90pass

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

LOG_CHANNEL=stack
LOG_LEVEL=info
RUN_MIGRATIONS=true
